generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  tier           String   @default("free")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Profile ───────────────────────────────────────────────────────────────────
// One profile per Supabase Auth user (userId = Supabase auth.users UUID)
model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique // Supabase Auth UUID
  name                String   @default("")
  handle              String?  @unique // custom @handle, e.g. "john_doe" (nullable = not yet chosen)
  bio                 String   @default("")
  avatar              String   @default("")
  paymentMethods      String[]
  shippingPreferences String[]
  interests           String[] // favorite categories from onboarding
  pinnedItemIds       String[] // item IDs pinned as Grails
  tier                String   @default("free")
  tooltipSeen         Boolean  @default(false)
  notifPush           Boolean  @default(true)
  notifTrades         Boolean  @default(true)
  notifMarket         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── Items (published grails / vault items) ───────────────────────────────────
model Item {
  id             String   @id @default(cuid())
  userId         String // current owner — swapped on trade completion
  title          String
  category       String
  imageUrl       String   @default("")
  estimatedValue Float?
  upForTrade     Boolean  @default(false)
  description    String   @default("")
  // Trade lifecycle: VAULT (owned, not active) | IN_TRADE (locked in a deal) | TRADED (ownership transferred)
  status         String   @default("VAULT")
  // Catalog identifier — set when item was matched against the catalog (AI scan or manual search).
  // Null for custom/manually-entered items. Used to gate Market Trajectory.
  masterId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
}

// ── User Achievements ─────────────────────────────────────────────────────────
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  catalystName  String?
  catalystImage String?

  @@unique([userId, achievementId])
  @@index([userId])
}

// ── Notifications ─────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String // Supabase Auth UUID
  message   String
  type      String   @default("achievement") // "trade"|"match"|"alert"|"achievement"
  isRead    Boolean  @default(false)
  href      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// ── Social Graph ──────────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  targetId   String
  targetType String   @default("activity") // "activity"
  createdAt  DateTime @default(now())

  @@unique([userId, targetId])
  @@index([targetId])
}

model Comment {
  id           String   @id @default(cuid())
  userId       String
  targetId     String
  targetType   String   @default("activity")
  text         String
  authorName   String
  authorAvatar String   @default("")
  createdAt    DateTime @default(now())

  @@index([targetId])
  @@index([userId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String // "grail_published" | "radar_added" | "achievement_unlocked"
  title     String   @default("")
  imageUrl  String   @default("")
  itemId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Market Items (eBay-seeded feed pool) ─────────────────────────────────────
// Populated by POST /api/feed/seed — never mixed with user-owned Item records.
model MarketItem {
  id        String   @id @default(cuid())
  ebayId    String   @unique
  title     String
  imageUrl  String
  price     Float
  category  String
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

// ── Trades ────────────────────────────────────────────────────────────────────
// Created when a user proposes a trade via ProposeTradeModal.
// proposerItemIds holds the DB item IDs being offered (set to IN_TRADE on create,
// TRADED on completion or back to VAULT on decline).
// offerData (JSON) holds the full display payload: items, cash, message, counterparty.
model Trade {
  id               String    @id @default(cuid())
  proposerId       String
  recipientId      String? // Supabase Auth UUID of the trade recipient
  proposerItemIds       String[] // DB item IDs being offered by proposer
  recipientItemIds      String[] // DB item IDs being offered by recipient (set on accept)
  offerData             Json // snapshot of the full offer for display & auditing
  status                String    @default("pending") // pending | accepted | completed | declined
  actionRequiredBy      String? // userId of the party who must act next (null = no action needed)
  completionConfirmedBy String[] // IDs of users who have confirmed delivery (double opt-in)
  createdAt             DateTime  @default(now())
  completedAt           DateTime?

  @@index([proposerId])
  @@index([recipientId])
  @@index([status])
  @@index([actionRequiredBy])
}

// ── Reviews ───────────────────────────────────────────────────────────────────
model Review {
  id           String   @id @default(cuid())
  authorId     String // Supabase Auth UUID
  recipientId  String // Supabase Auth UUID
  rating       Int
  comment      String   @default("")
  authorName   String
  authorAvatar String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([authorId, recipientId])
  @@index([recipientId])
  @@index([authorId])
}

// ── Market Snapshots (time-series financial engine) ──────────────────────────
// Architecture note: single polymorphic table keyed by (type, refId, bucket).
//   type  = "user"  → refId = userId,  value = total portfolio net worth
//   type  = "item"  → refId = item.id, value = estimatedValue at that moment
// The @@unique([type, refId, bucket]) allows efficient upserts: edits within
// the same hour overwrite the same row rather than creating 5 spam rows.
// bucket is always floor-to-the-hour so comparisons are deterministic.
model MarketSnapshot {
  id        String   @id @default(cuid())
  type      String   // "user" | "item"
  refId     String   // userId or item DB id
  value     Float
  bucket    DateTime // hour-truncated timestamp (floor to HH:00:00.000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, refId, bucket])
  @@index([type, refId, bucket(sort: Desc)])
}

// ── Messaging ─────────────────────────────────────────────────────────────────
model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String // Supabase Auth UUID
  displayName    String
  avatarUrl      String       @default("")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String // Supabase Auth UUID
  senderName     String
  content        String
  type           String       @default("text") // "text" | "trade-offer" | "system"
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
