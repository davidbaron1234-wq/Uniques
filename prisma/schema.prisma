generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  tier           String   @default("free")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Profile ───────────────────────────────────────────────────────────────────
// One profile per Supabase Auth user (userId = Supabase auth.users UUID)
model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique  // Supabase Auth UUID
  name                String   @default("")
  bio                 String   @default("")
  avatar              String   @default("")
  paymentMethods      String[]
  shippingPreferences String[]
  interests           String[]           // favorite categories from onboarding
  tooltipSeen         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── Items (published grails / vault items) ───────────────────────────────────
model Item {
  id             String   @id @default(cuid())
  userId         String                    // Supabase Auth UUID
  title          String
  category       String
  imageUrl       String   @default("")
  estimatedValue Float?
  upForTrade     Boolean  @default(false)
  description    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

// ── Notifications ─────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String                    // Supabase Auth UUID
  message   String
  type      String   @default("achievement")  // "trade"|"match"|"alert"|"achievement"
  isRead    Boolean  @default(false)
  href      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// ── Messaging ─────────────────────────────────────────────────────────────────
model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String       // Supabase Auth UUID
  displayName    String
  avatarUrl      String       @default("")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String       // Supabase Auth UUID
  senderName     String
  content        String
  type           String       @default("text")   // "text" | "trade-offer" | "system"
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
