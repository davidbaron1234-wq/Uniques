generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  tier           String   @default("free")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Profile ───────────────────────────────────────────────────────────────────
// One profile per Supabase Auth user (userId = Supabase auth.users UUID)
model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique  // Supabase Auth UUID
  name                String   @default("")
  bio                 String   @default("")
  avatar              String   @default("")
  paymentMethods      String[]
  shippingPreferences String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── Messaging ─────────────────────────────────────────────────────────────────
model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String       // Supabase Auth UUID
  displayName    String
  avatarUrl      String       @default("")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String       // Supabase Auth UUID
  senderName     String
  content        String
  type           String       @default("text")   // "text" | "trade-offer" | "system"
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
